#!/bin/bash
# .githooks/pre-commit
# PII safety pre-commit hook -- blocks commits containing PII patterns
# See docs/safe-data-handling.md for details

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- frozen-archive invariant ------------------------------------------------
# scripts/check_doc_pii.sh EXCLUDES .project/archive/agent-memory/ from its
# sweep (2026-08-06, operator ruling: "nothing should land in it that wasn't
# already committed"). That exclusion is sound ONLY while the tree is what it
# claims to be. Nothing about a PATH makes it frozen, so the invariant is
# ENFORCED here rather than assumed -- otherwise the carve-out is a standing
# fail-open into the only PII gate covering .project/, and a real identifier
# added there later would commit silently.
#
# PLACED ABOVE THE MISSING-SCANNER SKIP for the reason that block documents:
# that skip exits 0 and takes every later gate with it, including gates with no
# scanner dependency. This one depends on REPO_ROOT and git alone.
#
# THE TEST IS ON THE BLOB, NOT ON GIT'S RENAME DETECTION -- but that is only
# true if the ENUMERATION never sees a rename either, and `--diff-filter=AM`
# alone does NOT achieve it. `--no-renames` is what makes the claim true, and
# omitting it was a live bypass: git records a move-AND-edit as `R<score>`, so
# `--diff-filter=AM` drops it entirely, the candidate set comes back empty, and
# edited content lands in the one tree no PII gate sweeps. Measured: an
# 8-line file moved in with one line appended scores `R058` and enumerates as
# NOTHING under AM-with-renames, versus the destination path under
# `--no-renames`. Never drop it here. (The retired archive-reference gate passed
# `--no-renames` for this same reason.)
#
# With it, a pure move normalizes to D-plus-A, the destination lands in the `A`
# half, and its blob is already in HEAD -- admissible. A move-and-edit, or new
# content, produces a blob HEAD has never seen -- blocked, which is precisely
# the case the byte-gate exclusion cannot cover.
FROZEN_PREFIX=".project/archive/agent-memory/"
_frozen_candidates=()
while IFS= read -r -d '' _p; do
  case "$_p" in
    "$FROZEN_PREFIX"*) _frozen_candidates+=("$_p") ;;
  esac
done < <(git -C "$REPO_ROOT" diff --cached --name-only -z --no-renames --diff-filter=AM)

if [ ${#_frozen_candidates[@]} -gt 0 ]; then
  # Computed only when a candidate exists, so ordinary commits pay nothing.
  # An absent HEAD (initial commit) yields an empty list, which blocks -- the
  # fail-closed direction.
  _head_blobs="$(git -C "$REPO_ROOT" ls-tree -r HEAD 2>/dev/null | awk '{print $3}' | sort -u)"
  _frozen_violations=""
  # Iterating the ARRAY, never a re-split string: a path containing a newline
  # would otherwise split into fragments that resolve to no blob. And the
  # lookup uses `:(literal)` pathspec magic, because `git ls-files -- "$p"`
  # treats its argument as a GLOB -- a path holding `*` or `?` can match
  # several entries, and a multi-line $_blob would then satisfy `grep -qxF`
  # on any one of them.
  for _p in "${_frozen_candidates[@]}"; do
    _blob="$(git -C "$REPO_ROOT" ls-files --stage -- ":(literal)$_p" | awk '{print $2}')"
    # An unresolvable staged path is INVALID, not admissible -- refuse.
    if [ -z "$_blob" ] || ! printf '%s\n' "$_head_blobs" | grep -qxF "$_blob"; then
      _frozen_violations="${_frozen_violations}  ${_p}"$'\n'
    fi
  done

  if [ -n "$_frozen_violations" ]; then
    echo "[frozen-archive: BLOCKED] new or edited content under ${FROZEN_PREFIX}" >&2
    printf '%s' "$_frozen_violations" >&2
    echo "" >&2
    echo "[frozen-archive] That tree is EXCLUDED from the doc-PII byte-gate because it is" >&2
    echo "[frozen-archive] supposed to receive only content already committed elsewhere." >&2
    echo "[frozen-archive] These files are new or modified, so nothing has PII-scanned them." >&2
    echo "[frozen-archive] Either revert them, or scan them by hand and lift this gate" >&2
    echo "[frozen-archive] deliberately -- do not widen the byte-gate exclusion to cover them." >&2
    exit 1
  fi
fi
# --- end frozen-archive invariant --------------------------------------------

if [ ! -f "$REPO_ROOT/src/safety/pii_scanner.py" ]; then
  echo "[pii-hook] Scanner not installed yet. Skipping PII check."
  exit 0
fi

# Get staged files (Added, Copied, Modified, Renamed -- not Deleted).
# R is load-bearing: without it a staged rename is invisible here, so a rename
# carrying a content edit reaches no gate, and a rename-only staged set empties
# the list and exits below before any gate runs. `--name-only` reports a
# rename's destination path, which is the path to scan.
# -z is the only safe enumeration: without it git C-quotes any path containing a
# non-ASCII byte, a double-quote, or a backslash, and such a path matches no
# prefix and names no readable file. core.quotePath=false covers only the
# non-ASCII case.
# The NUL read is a `while read -d ''` loop, not `mapfile -d ''`: mapfile's -d
# needs bash 4.4+, and the documented Mac host ships bash 3.2, where mapfile -d
# would error and leave STAGED_ARR empty -- passing the commit with both gates
# inert (fail-open). This loop is bash 3.2+.
STAGED_ARR=()
while IFS= read -r -d '' _f; do STAGED_ARR+=("$_f"); done \
  < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ ${#STAGED_ARR[@]} -eq 0 ]; then
  exit 0
fi

# Run scanner as a module (avoids sys.path manipulation in src/).
# `pii_scanner --stdin` is line-delimited, so a path containing a newline cannot
# be represented to it. Such a path is unscannable by construction here.
cd "$REPO_ROOT" && printf '%s\n' "${STAGED_ARR[@]}" | python3 -m src.safety.pii_scanner --stdin
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "[pii-hook] Commit blocked. Fix the violations above, then try again."
  echo "[pii-hook] If this is a false positive, see docs/safe-data-handling.md"
  exit 1
fi

# --- doc-PII byte-gate over the planning trees -------------------------------
# The pattern scanner skips epics/ and .project/ (shape heuristics are all noise
# there). The byte-gate greps them for literal known identifiers instead.
DOC_PII="$REPO_ROOT/scripts/check_doc_pii.sh"

# Path prefixes are matched literally: `.project` as a regex would let a staged
# `aproject/x.md` select the .project tree.
GATE_TREES=()
for tree in epics .project; do
  for staged in "${STAGED_ARR[@]}"; do
    case "$staged" in
      "$tree"/*) GATE_TREES+=("$tree"); break ;;
    esac
  done
done

doc_pii_block() {
  echo "[doc-pii: BLOCKED] $1" >&2
  echo "" >&2
  echo "[pii-hook] Commit blocked by the doc-PII byte-gate." >&2
  echo "[pii-hook] See .claude/rules/pii-safety.md" >&2
  exit 1
}

if [ ${#GATE_TREES[@]} -gt 0 ]; then
  [ -x "$DOC_PII" ] || doc_pii_block "scripts/check_doc_pii.sh is missing or not executable"

  SNAP="$(mktemp -d)" || doc_pii_block "cannot create a temp dir for the index snapshot"
  # shellcheck disable=SC2064
  trap "rm -rf '$SNAP'" EXIT

  # The gate greps a directory, but a commit hook must judge the INDEX, not the
  # working tree -- they diverge under `git add -p` or staged-then-edited.
  # --ignore-skip-worktree-bits: without it, checkout-index omits skip-worktree
  # entries and the gate certifies a snapshot the index disagrees with.
  git checkout-index --ignore-skip-worktree-bits --prefix="$SNAP/" -a \
    || doc_pii_block "git checkout-index failed; refusing to certify"

  BLOCKED=0
  INCONCLUSIVE=0
  GATED=0
  for tree in "${GATE_TREES[@]}"; do
    if [ ! -d "$SNAP/$tree" ]; then
      BLOCKED=1
      echo "[doc-pii: BLOCKED] $tree/ is staged but absent from the index snapshot" >&2
      continue
    fi
    GATE_OUT="$("$DOC_PII" "$SNAP/$tree" 2>&1)"
    GATE_RC=$?
    GATED=$((GATED + 1))
    case "$GATE_RC" in
      0) ;;
      3) INCONCLUSIVE=1 ;;
      *)
        BLOCKED=1
        echo "$GATE_OUT" | sed "s#$SNAP/##" >&2
        echo "[doc-pii: BLOCKED] $tree/ (exit $GATE_RC)" >&2
        ;;
    esac
  done

  # A gate that never ran is INVALID, not a pass: 0 findings and 0 executions are
  # the same counter state otherwise.
  if [ "$GATED" -ne ${#GATE_TREES[@]} ]; then
    BLOCKED=1
    echo "[doc-pii: BLOCKED] gated $GATED of ${#GATE_TREES[@]} staged trees" >&2
  fi

  if [ $BLOCKED -ne 0 ]; then
    echo "" >&2
    echo "[pii-hook] Commit blocked by the doc-PII byte-gate." >&2
    echo "[pii-hook] See .claude/rules/pii-safety.md" >&2
    exit 1
  fi

  if [ $INCONCLUSIVE -ne 0 ]; then
    # Exit 3 is the default state on a fresh clone (the denylist is gitignored).
    # Blocking here would make a fresh clone uncommittable and the hook would be
    # uninstalled, taking the exit-1 detection with it.
    echo "[doc-pii: INCONCLUSIVE — example mode]"
  else
    echo "[doc-pii: REAL, 0 matches]"
  fi
fi

echo "[pii-hook] PII scan passed."
exit 0
