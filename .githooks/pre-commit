#!/bin/bash
# .githooks/pre-commit
# PII safety pre-commit hook -- blocks commits containing PII patterns
# See docs/safe-data-handling.md for details

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- archive-reference gate --------------------------------------------------
# PLACED FIRST BY REQUIREMENT, and the requirement is not stylistic. Every other
# gate in this file sits below at least one unconditional `exit 0` -- the
# missing-scanner skip immediately below returns 0 when
# src/safety/pii_scanner.py is absent, and it takes every later gate with it,
# including gates that have no dependency on the scanner at all. A gate placed
# below it is inert in exactly the case it exists for. So this block depends on
# REPO_ROOT and its own enumeration alone: not on the scanner, not on
# STAGED_ARR, not on GATE_TREES.
#
# MISSING-DEPENDENCY POSTURE DIVERGES FROM ITS NEIGHBOUR, DELIBERATELY.
# This gate BLOCKS when its script is missing or non-executable -- a gate that
# never ran is INVALID, not a pass. A few lines below, the scanner check does
# the OPPOSITE for its own missing dependency: it prints a skip and exits 0.
# DO NOT HARMONIZE THEM. The pull will be to match the older neighbour because
# matching the incumbent always looks like the conservative edit; here it would
# convert a fail-closed gate into a fail-open one.
ARCHIVE_REFS="$REPO_ROOT/scripts/check_archive_refs.sh"

# OWN ENUMERATION -- deliberately NOT the STAGED_ARR built further down. That
# array is --diff-filter=ACMR and carries no `D` at all, so a staged deletion is
# structurally invisible to it; since the trigger below requires observing a
# deletion, a version reusing it could never fire under any circumstances. The
# ready-made array sitting a few lines away is the trap here, not a shortcut.
#
# --no-renames is what makes the trigger rename-shape-independent: `git apply
# --3way` may land the archive move as delete+add rather than a rename when
# similarity drops (plausible here -- the epic file is rewritten during its own
# epic), and --no-renames normalizes BOTH representations to the same D-plus-A
# pair. Never condition on `rename from` appearing in the diff.
#
# -z rather than the default: without it git C-quotes any path carrying a
# non-ASCII byte, a double-quote or a backslash, and a quoted path would not
# match the prefixes below -- the gate would fail OPEN on exactly the commit
# that mattered, silently.
_ARCH_DEL=""
_ARCH_ADD=""
while IFS= read -r -d '' _p; do
  case "$_p" in
    epics/E-[0-9][0-9][0-9]-*) _ARCH_DEL="$_ARCH_DEL ${_p:6:5}" ;;
  esac
done < <(git diff --cached --name-only -z --no-renames --diff-filter=D)
while IFS= read -r -d '' _p; do
  case "$_p" in
    .project/archive/E-[0-9][0-9][0-9]-*) _ARCH_ADD="$_ARCH_ADD ${_p:17:5}" ;;
  esac
done < <(git diff --cached --name-only -z --no-renames --diff-filter=A)

# BOTH HALVES REQUIRED, for the SAME epic id. Either half alone fires on
# ordinary commits: annotating or adding a file under an already-archived epic
# (the `A`/`M` side), or deleting a superseded story from a still-LIVE epics
# directory (the `D` side) -- and that live directory's own internal
# cross-references would then block a commit that archives nothing.
ARCHIVING_IDS=""
for _d in $_ARCH_DEL; do
  case " $_ARCH_ADD " in
    *" $_d "*)
      case " $ARCHIVING_IDS " in
        *" $_d "*) ;;
        *) ARCHIVING_IDS="$ARCHIVING_IDS $_d" ;;
      esac
      ;;
  esac
done

if [ -n "$ARCHIVING_IDS" ]; then
  if [ ! -x "$ARCHIVE_REFS" ]; then
    echo "[archive-refs: BLOCKED] scripts/check_archive_refs.sh is missing or not executable" >&2
    echo "[archive-refs] A gate that never ran is INVALID, not a pass." >&2
    exit 1
  fi
  for _id in $ARCHIVING_IDS; do
    if ! "$ARCHIVE_REFS" "$_id" "$REPO_ROOT"; then
      echo "" >&2
      echo "[archive-refs] Commit blocked by the archive-reference gate." >&2
      echo "[archive-refs] There is no override for this gate. \`git commit --no-verify\`" >&2
      echo "[archive-refs] is the only escape, and it disables the PII scan as well." >&2
      exit 1
    fi
  done
fi
# --- end archive-reference gate ----------------------------------------------

if [ ! -f "$REPO_ROOT/src/safety/pii_scanner.py" ]; then
  echo "[pii-hook] Scanner not installed yet. Skipping PII check."
  exit 0
fi

# Get staged files (Added, Copied, Modified, Renamed -- not Deleted).
# R is load-bearing: without it a staged rename is invisible here, so a rename
# carrying a content edit reaches no gate, and a rename-only staged set empties
# the list and exits below before any gate runs. `--name-only` reports a
# rename's destination path, which is the path to scan.
# -z is the only safe enumeration: without it git C-quotes any path containing a
# non-ASCII byte, a double-quote, or a backslash, and such a path matches no
# prefix and names no readable file. core.quotePath=false covers only the
# non-ASCII case.
# The NUL read is a `while read -d ''` loop, not `mapfile -d ''`: mapfile's -d
# needs bash 4.4+, and the documented Mac host ships bash 3.2, where mapfile -d
# would error and leave STAGED_ARR empty -- passing the commit with both gates
# inert (fail-open). This loop is bash 3.2+.
STAGED_ARR=()
while IFS= read -r -d '' _f; do STAGED_ARR+=("$_f"); done \
  < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ ${#STAGED_ARR[@]} -eq 0 ]; then
  exit 0
fi

# Run scanner as a module (avoids sys.path manipulation in src/).
# `pii_scanner --stdin` is line-delimited, so a path containing a newline cannot
# be represented to it. Such a path is unscannable by construction here.
cd "$REPO_ROOT" && printf '%s\n' "${STAGED_ARR[@]}" | python3 -m src.safety.pii_scanner --stdin
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "[pii-hook] Commit blocked. Fix the violations above, then try again."
  echo "[pii-hook] If this is a false positive, see docs/safe-data-handling.md"
  exit 1
fi

# --- doc-PII byte-gate over the planning trees -------------------------------
# The pattern scanner skips epics/ and .project/ (shape heuristics are all noise
# there). The byte-gate greps them for literal known identifiers instead.
DOC_PII="$REPO_ROOT/scripts/check_doc_pii.sh"

# Path prefixes are matched literally: `.project` as a regex would let a staged
# `aproject/x.md` select the .project tree.
GATE_TREES=()
for tree in epics .project; do
  for staged in "${STAGED_ARR[@]}"; do
    case "$staged" in
      "$tree"/*) GATE_TREES+=("$tree"); break ;;
    esac
  done
done

doc_pii_block() {
  echo "[doc-pii: BLOCKED] $1" >&2
  echo "" >&2
  echo "[pii-hook] Commit blocked by the doc-PII byte-gate." >&2
  echo "[pii-hook] See .claude/rules/pii-safety.md" >&2
  exit 1
}

if [ ${#GATE_TREES[@]} -gt 0 ]; then
  [ -x "$DOC_PII" ] || doc_pii_block "scripts/check_doc_pii.sh is missing or not executable"

  SNAP="$(mktemp -d)" || doc_pii_block "cannot create a temp dir for the index snapshot"
  # shellcheck disable=SC2064
  trap "rm -rf '$SNAP'" EXIT

  # The gate greps a directory, but a commit hook must judge the INDEX, not the
  # working tree -- they diverge under `git add -p` or staged-then-edited.
  # --ignore-skip-worktree-bits: without it, checkout-index omits skip-worktree
  # entries and the gate certifies a snapshot the index disagrees with.
  git checkout-index --ignore-skip-worktree-bits --prefix="$SNAP/" -a \
    || doc_pii_block "git checkout-index failed; refusing to certify"

  BLOCKED=0
  INCONCLUSIVE=0
  GATED=0
  for tree in "${GATE_TREES[@]}"; do
    if [ ! -d "$SNAP/$tree" ]; then
      BLOCKED=1
      echo "[doc-pii: BLOCKED] $tree/ is staged but absent from the index snapshot" >&2
      continue
    fi
    GATE_OUT="$("$DOC_PII" "$SNAP/$tree" 2>&1)"
    GATE_RC=$?
    GATED=$((GATED + 1))
    case "$GATE_RC" in
      0) ;;
      3) INCONCLUSIVE=1 ;;
      *)
        BLOCKED=1
        echo "$GATE_OUT" | sed "s#$SNAP/##" >&2
        echo "[doc-pii: BLOCKED] $tree/ (exit $GATE_RC)" >&2
        ;;
    esac
  done

  # A gate that never ran is INVALID, not a pass: 0 findings and 0 executions are
  # the same counter state otherwise.
  if [ "$GATED" -ne ${#GATE_TREES[@]} ]; then
    BLOCKED=1
    echo "[doc-pii: BLOCKED] gated $GATED of ${#GATE_TREES[@]} staged trees" >&2
  fi

  if [ $BLOCKED -ne 0 ]; then
    echo "" >&2
    echo "[pii-hook] Commit blocked by the doc-PII byte-gate." >&2
    echo "[pii-hook] See .claude/rules/pii-safety.md" >&2
    exit 1
  fi

  if [ $INCONCLUSIVE -ne 0 ]; then
    # Exit 3 is the default state on a fresh clone (the denylist is gitignored).
    # Blocking here would make a fresh clone uncommittable and the hook would be
    # uninstalled, taking the exit-1 detection with it.
    echo "[doc-pii: INCONCLUSIVE — example mode]"
  else
    echo "[doc-pii: REAL, 0 matches]"
  fi
fi

echo "[pii-hook] PII scan passed."
exit 0
