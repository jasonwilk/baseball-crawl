# Direct runtime dependencies for baseball-crawl.
# Keep in sync with [project.dependencies] in pyproject.toml
# requirements.txt is GENERATED by pip-compile -- do not edit it directly.
# To regenerate: pip-compile requirements.in -o requirements.txt --strip-extras --generate-hashes

httpx~=0.28          # HTTP client for GameChanger crawlers
fastapi~=0.115       # API framework (FastAPI)
uvicorn[standard]~=0.34  # ASGI server for FastAPI
starlette>=0.49.1,<2 # Pinned explicitly -- FastAPI transitive; we import run_in_threadpool directly.
                     # Floor: the CVE-2025-54121 / GHSA-7f5h-v6xp-fcq8 fix landed in 0.49.1.
                     # Ceiling: FastAPI 0.139 dropped its own starlette upper bound, so nothing
                     # else bounds it -- without <2 a --upgrade could cross a major on a package
                     # src/api/ imports from at 13 sites. ~= cannot express this (E-256-07).
jinja2>=3.1.6,<4     # HTML templating. Floor pins past CVE-2025-27516; ceiling preserves the
                     # <4 that the previous ~=3.1 implied. ~=3.1 would still permit the
                     # vulnerable 3.1.5, and ~=3.1.6 would wrongly block 3.2 (E-256-07).
aiofiles~=24.1       # Async file I/O for static file serving
python-multipart>=0.0.31,<0.1  # Form parsing (FastAPI Form() params). Floor = highest fix floor
                     # of its 6 advisories (CVE-2026-53540); <0.1 preserves what ~=0.0.20 implied.
webauthn~=2.2        # WebAuthn / passkey support
python-dotenv~=1.0   # Environment variable loading from .env files
pyyaml~=6.0          # YAML config parsing (teams.yaml)
typer[all]>=0.9      # CLI framework for operator commands (rich + shellingham extras)
brotlicffi~=1.0     # Brotli decompression for httpx (mobile profile uses br encoding)
matplotlib~=3.9     # Spray chart rendering (PNG generation via Agg backend)
numpy~=2.0          # Required by matplotlib; used in chart calculations
tzdata>=2025.2      # The FULL IANA database for `zoneinfo`, including the legacy
                    # "backward" alias links (`US/Central`, `US/Pacific`, ...).
                    # NOT optional here: `python:*-slim` omits those links, so
                    # `ZoneInfo("US/Central")` raises ZoneInfoNotFoundError and a
                    # game whose GameChanger payload carries that (operator-typed)
                    # spelling loses its venue-local date (E-278-04). `~=` is wrong
                    # for a CalVer-ish YYYY.N package -- `~=2025.2` would pin the
                    # whole 2026 series out and freeze the zone data (E-256-07's
                    # "some packages use >= where compatible-release doesn't fit").
