# Dev-only dependencies, layered on top of runtime deps.
# requirements-dev.txt is GENERATED by pip-compile -- do not edit it directly.

-c requirements.txt   # Pin shared deps to same versions as production
-r requirements.in

pytest==9.0.3          # Test runner (bumped from 8.3.4 for PYSEC-2026-1845 / GHSA predictable /tmp/pytest-of-* path)
pytest-asyncio~=1.0    # Async test support for pytest (1.x required for pytest 9 compat)
pytest-timeout==2.3.1  # Per-test timeout enforcement
respx~=0.22            # HTTP mocking for httpx in tests
pyyaml~=6.0            # YAML frontmatter parsing for API doc validation
ruff==0.15.20          # Lint (F/pyflakes only -- see [tool.ruff] in pyproject.toml)
