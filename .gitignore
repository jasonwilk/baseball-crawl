# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# pytest
.pytest_cache/

# Environment / credentials
.env
.env.*
!.env.example
secrets/

# Closure runtime smoke fixture (Phase 5 Step 1d) -- holds LSB's own real
# identifiers (generate=<public_id>, morning-run=<lsb-urls>); never committed.
.smoke-fixture

# IDE
.vscode/
.idea/

# Claude Code local settings (per-machine permissions)
.claude/settings.local.json

# Claude Code session state (ScheduleWakeup tool creates this)
.claude/scheduled_tasks.lock

# Codex local runtime state
.codex-home/

# Docker Compose local overrides (copy from .example)
docker-compose.override.yml

# OS
.DS_Store

# Data (local dev outputs)
# Ignore the runtime database and any other generated files under data/.
data/

# Database backups (created by scripts/backup_db.py)
data/backups/


# Ephemeral data directory -- safe zone for raw API responses and scratch data
/ephemeral/*
!/ephemeral/README.md
!/ephemeral/scratch/
/ephemeral/scratch/*
!/ephemeral/scratch/.gitkeep
